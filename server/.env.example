# Copy this file to .env and fill in your own values.

# Port for the Express server (Render sets this automatically)
PORT=3333

# Secret key for admin endpoints (POST/PUT/DELETE /products).
# Send it in the "x-api-key" request header. Use a long random string.
ADMIN_API_KEY=change-me

# Frontend URLs allowed by CORS, comma-separated
CORS_ORIGINS=https://pet-shop-roan-five.vercel.app,http://localhost:5173
